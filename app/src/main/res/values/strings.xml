    <string name="help_nearby_t">附近</string>
    <string name="help_nearby_b">清單是上次記住的位置。第一次開啟是中環，定位後改為你的位置。巴士約 400 米，專線小巴約 180 米。</string>
    <string name="help_gmb_t">專小</string>
    <string name="help_gmb_b">綠色專線小巴。紅色小巴沒有官方到站。</string>
    <string name="help_sched_t">預定</string>
    <string name="help_sched_b">營辦商標為預定或未開出，不是車輛定位。</string>
    <string name="help_none_t">暫無</string>
    <string name="help_none_b">官方沒有到站時間。這裡不會估算。</string>
    <string name="help_side_t">上行／下行</string>
    <string name="help_side_b">港鐵官方時刻的上行與下行，不是地圖上的南北。</string>
    <string name="help_svc_t">服務類型</string>
    <string name="help_svc_b">九巴服務類型。同一路線編號可有不同走線。</string>
    <string name="help_min_t">分鐘</string>
    <string name="help_min_b">由官方預計到站換算。三分鐘內先顯示上次結果，並立即更新。</string>
    <string name="help_mock_t">未能規劃</string>
    <string name="help_mock_b">沒有步行或轉乘路徑。</string>
    <string name="help_map_t">地圖</string>
    <string name="help_map_b">這是站點位置示意，不是地圖。</string>
    <string name="help_geo_t">港鐵距離</string>
    <string name="help_geo_b">距離用車站出口座標估算，不是月台位置。</string>
